public class ArrayReversal {

    // Standard array reversal method
    public static void reverseArray(int[] arr) {
        // Edge case: null or single-element/empty array
        if (arr == null || arr.length <= 1) {
            return;
        }
        
        int left = 0;
        int right = arr.length - 1;
        
        while (left < right) {
            int temp = arr[left];
            arr[left] = arr[right];
            arr[right] = temp;
            left++;
            right--;
        }
    }

    // Helper method for reversing a specific range (Subarray / Range Reversal)
    public static void reverseRange(int[] arr, int start, int end) {
        if (arr == null || start < 0 || end >= arr.length || start >= end) {
            return;
        }
        
        while (start < end) {
            int temp = arr[start];
            arr[start] = arr[end];
            arr[end] = temp;
            start++;
            end--;
        }
    }
}
